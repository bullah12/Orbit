# Orbit runs with zero credentials. Everything below has a working default.

# Written by ./scripts/db-reset.sh. The app role is NOT a table owner, so RLS
# applies to it in full.
DATABASE_URL=postgres://orbit_app:orbit_dev_password@localhost:5432/orbit

# Seeding only. This role has BYPASSRLS and must never be used at request time.
SEED_DATABASE_URL=postgres://orbit_seed:orbit_dev_password@localhost:5432/orbit

# Integrations. See src/lib/integrations/. `fake` is fixture-backed, needs no
# credentials and is the default. An unrecognised value is a hard error, not a
# silent fall back to the fake — only the values listed here are accepted.
CALENDAR_PROVIDER=fake       # fake | google   (google: written, never run)
ICS_PROVIDER=fake            # fake | http     (http: written, never run)
GEOCODING_PROVIDER=fake      # fake            (real one belongs to Phase 3)
TRAVEL_TIME_PROVIDER=fake    # fake            (real one belongs to Phase 3)
PUSH_PROVIDER=fake           # fake            (real one belongs to Phase 4)
AI_PROVIDER=fake             # fake            (real one belongs to Phase 5)

# Only read when CALENDAR_PROVIDER=google. Absent by default, and absent is
# fine: the app boots and demos with zero credentials, and the Google provider
# reports a missing credential when it is called rather than at startup.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# Dev auth: a signed cookie naming a seeded profile. No OAuth, no password.
AUTH_PROVIDER=dev
AUTH_COOKIE_SECRET=orbit-dev-secret-not-for-production
