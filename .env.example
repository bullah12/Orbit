# Orbit runs with zero credentials. Everything below has a working default.

# Written by ./scripts/db-reset.sh. The app role is NOT a table owner, so RLS
# applies to it in full.
DATABASE_URL=postgres://orbit_app:orbit_dev_password@localhost:5432/orbit

# Seeding only. This role has BYPASSRLS and must never be used at request time.
SEED_DATABASE_URL=postgres://orbit_seed:orbit_dev_password@localhost:5432/orbit

# Integrations. See src/lib/integrations/. `fake` is fixture-backed, needs no
# credentials and is the default. An unrecognised value is a hard error, not a
# silent fall back to the fake — only the values listed here are accepted.
CALENDAR_PROVIDER=fake       # fake | google   (google: written, never run)
ICS_PROVIDER=fake            # fake | http     (http: written, never run)
GEOCODING_PROVIDER=fake      # fake | nominatim        (nominatim: written, never run)
TRAVEL_TIME_PROVIDER=fake    # fake | openrouteservice (ors: written, never run)
PUSH_PROVIDER=fake           # fake | webpush  (webpush written, never run)
# Web Push needs a VAPID key pair and a contact the push service operator can
# reach you at. All three are read when the provider is called, never at boot.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
AI_PROVIDER=fake             # fake | anthropic  (anthropic is written, never run)

# Only read when CALENDAR_PROVIDER=google. Absent by default, and absent is
# fine: the app boots and demos with zero credentials, and the Google provider
# reports a missing credential when it is called rather than at startup.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# Only read when GEOCODING_PROVIDER=nominatim. Nominatim has no API key, but
# its usage policy requires a real contact in the User-Agent — so this is a
# credential in every sense that matters, and its absence fails the call.
# NOMINATIM_CONTACT=you@example.com

# Only read when TRAVEL_TIME_PROVIDER=openrouteservice.
# ORS_API_KEY=

# Only read when AI_PROVIDER=anthropic. The key is read when the provider is
# *called*, never at boot, so the app runs and demos with it absent. The model
# defaults to claude-opus-5.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Auth. `dev` is a cookie naming a seeded profile: no OAuth, no password, and no
# credential of any kind, which is what lets Orbit run end to end on a cold
# container. It is the default and it stays the default.
#
# `supabase` verifies a real Supabase session server-side and hands the JWT's
# `sub` to the same asUser() every query already goes through. It is **written,
# never run** — there is no project and no credential here — exactly like the
# Google calendar provider. An unrecognised value is a hard error.
AUTH_PROVIDER=dev            # dev | supabase  (supabase: written, never run)
AUTH_COOKIE_SECRET=orbit-dev-secret-not-for-production

# The dev provider is impersonation by design: no password, and a switcher in
# the sidebar. On a *production build* Orbit therefore refuses to start with it,
# because `dev` is the default and the dangerous case is forgetting to set
# AUTH_PROVIDER at all rather than mistyping it.
#
# `pnpm start` sets this so the local production run and `pnpm smoke` still work
# with zero credentials. The Dockerfile deliberately does not, and it runs
# `node server.js` rather than `pnpm start`, so nothing here can leak into an
# image. Set it in a deployment only if you mean it.
# ORBIT_ALLOW_DEV_AUTH=1

# Only read when AUTH_PROVIDER=supabase, and read when the provider is *called*
# rather than at boot — so the app still starts and says what is missing.
# The anon key is public by design: RLS is what protects the data. Never put a
# service-role key anywhere near this application; there is deliberately no
# client that could use one.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=
#
# Where Supabase sends people back to after a magic link. Must be the app's own
# public origin, and must be in the project's allowed redirect URLs.
# APP_URL=http://localhost:3000

# Prepared statements. Leave this alone unless you are connecting through
# Supabase's *transaction* pooler on port 6543, which hands a different backend
# to every statement — set it to `false` there, or asUser()'s queries will fail
# with "prepared statement does not exist". Session mode (5432) needs nothing.
# DATABASE_PREPARE=false
