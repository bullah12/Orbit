# Orbit runs with zero credentials. Everything below has a working default.

# Written by ./scripts/db-reset.sh. The app role is NOT a table owner, so RLS
# applies to it in full.
DATABASE_URL=postgres://orbit_app:orbit_dev_password@localhost:5432/orbit

# Seeding only. This role has BYPASSRLS and must never be used at request time.
SEED_DATABASE_URL=postgres://orbit_seed:orbit_dev_password@localhost:5432/orbit

# Integrations. `fake` is fixture-backed and needs no credentials; it is the
# default and the only implementation that currently exists end to end.
CALENDAR_PROVIDER=fake       # fake | google
ICS_PROVIDER=fake            # fake | http
GEOCODING_PROVIDER=fake      # fake | nominatim
TRAVEL_TIME_PROVIDER=fake    # fake | google
PUSH_PROVIDER=fake           # fake | webpush
AI_PROVIDER=fake             # fake | anthropic

# Dev auth: a signed cookie naming a seeded profile. No OAuth, no password.
AUTH_PROVIDER=dev
AUTH_COOKIE_SECRET=orbit-dev-secret-not-for-production
