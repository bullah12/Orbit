# Orbit runs with zero credentials. Everything below has a working default.

# Written by ./scripts/db-reset.sh. The app role is NOT a table owner, so RLS
# applies to it in full.
DATABASE_URL=postgres://orbit_app:orbit_dev_password@localhost:5432/orbit

# Seeding only. This role has BYPASSRLS and must never be used at request time.
SEED_DATABASE_URL=postgres://orbit_seed:orbit_dev_password@localhost:5432/orbit

# Integrations. See src/lib/integrations/. `fake` is fixture-backed, needs no
# credentials and is the default. An unrecognised value is a hard error, not a
# silent fall back to the fake — only the values listed here are accepted.
CALENDAR_PROVIDER=fake       # fake | google   (google: written, never run)
ICS_PROVIDER=fake            # fake | http     (http: written, never run)
GEOCODING_PROVIDER=fake      # fake | nominatim        (nominatim: written, never run)
TRAVEL_TIME_PROVIDER=fake    # fake | openrouteservice (ors: written, never run)
PUSH_PROVIDER=fake           # fake | webpush  (webpush written, never run)
# Web Push needs a VAPID key pair and a contact the push service operator can
# reach you at. All three are read when the provider is called, never at boot.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
AI_PROVIDER=fake             # fake | anthropic  (anthropic is written, never run)

# Only read when CALENDAR_PROVIDER=google. Absent by default, and absent is
# fine: the app boots and demos with zero credentials, and the Google provider
# reports a missing credential when it is called rather than at startup.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# Only read when GEOCODING_PROVIDER=nominatim. Nominatim has no API key, but
# its usage policy requires a real contact in the User-Agent — so this is a
# credential in every sense that matters, and its absence fails the call.
# NOMINATIM_CONTACT=you@example.com

# Only read when TRAVEL_TIME_PROVIDER=openrouteservice.
# ORS_API_KEY=

# Only read when AI_PROVIDER=anthropic. The key is read when the provider is
# *called*, never at boot, so the app runs and demos with it absent. The model
# defaults to claude-opus-5.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Dev auth: a signed cookie naming a seeded profile. No OAuth, no password.
AUTH_PROVIDER=dev
AUTH_COOKIE_SECRET=orbit-dev-secret-not-for-production
