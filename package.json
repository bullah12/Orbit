    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "playwright": "^1.62.1",
    "postgres": "^3.4.9",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.10"
